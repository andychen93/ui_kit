{
    "name": "@argon-kit/html",
    "version": "0.1.0",
    "description": "Argon UI Kit - Pure HTML/CSS/JavaScript implementation",
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./style": "./dist/assets/html.css",
        "./package.json": "./package.json"
    },
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist"
    ],
    "dependencies": {
        "@argon-kit/core": "workspace:*",
        "@argon-kit/icons": "workspace:*",
        "@argon-kit/styles": "workspace:*"
    },
    "devDependencies": {
        "@testing-library/dom": "^10.4.0",
        "@types/node": "^22.10.0",
        "@vitest/ui": "^3.0.5",
        "jsdom": "^26.0.0",
        "typescript": "^5.6.3",
        "vite": "^6.4.3",
        "vite-plugin-dts": "^4.5.0",
        "vitest": "^3.0.5"
    },
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit -p tsconfig.json"
    }
}