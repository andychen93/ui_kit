{
    "name": "@argon-kit/html-calendar",
    "version": "0.1.0",
    "description": "Argon UI Kit - HTML Calendar Plugin (FullCalendar wrapper)",
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": ["dist"],
    "dependencies": {
        "@argon-kit/html": "workspace:*",
        "@argon-kit/styles": "workspace:*",
        "@fullcalendar/core": "^6.1.15",
        "@fullcalendar/daygrid": "^6.1.15",
        "@fullcalendar/interaction": "^6.1.15"
    },
    "devDependencies": {
        "@vitest/ui": "^3.0.5",
        "jsdom": "^23.2.0",
        "typescript": "^5.6.3",
        "vite": "^6.4.3",
        "vite-plugin-dts": "^4.5.0",
        "vitest": "^3.0.5"
    },
    "scripts": {
        "build": "vite build",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "test": "vitest run"
    }
}